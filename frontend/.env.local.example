# Point this at the FastAPI service. Locally that is uvicorn on :8000; in
# production it is the API service's URL. Read at BUILD time, not run time --
# changing it on a deployed service requires a rebuild, not just a restart.
#
# On Render the blueprint sets NEXT_PUBLIC_API_HOST (a bare hostname) instead
# and next.config.mjs turns it into an https:// origin.
NEXT_PUBLIC_API_URL=http://localhost:8000
