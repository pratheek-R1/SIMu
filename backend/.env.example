# ---------------------------------------------------------------------------
# Database -- Supabase PostgreSQL
# ---------------------------------------------------------------------------
# Use the SESSION pooler connection string (port 5432), not the transaction
# pooler (6543): asyncpg's prepared statements are incompatible with the latter.
# Swap postgresql:// for postgresql+asyncpg:// in the URL Supabase gives you.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Cache -- Upstash Redis
# ---------------------------------------------------------------------------
# Optional. Without it the API falls back to a per-process cache, which is
# correct for a single worker and wrong for multiple replicas.
REDIS_URL=rediss://default:PASSWORD@REGION.upstash.io:6379
CACHE_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Storage -- Supabase Storage
# ---------------------------------------------------------------------------
# Create a bucket named `reports`. Reports are also persisted to Postgres, so
# leaving these unset degrades gracefully rather than losing student work.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_REPORT_BUCKET=reports

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=production
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
INR_RATE=83
DELIBERATION_SECONDS=15

# The dataset seed for students with no cohort assigned. Give each teaching
# cohort its own seed via POST /api/v1/admin/cohorts -- reusing one across
# semesters means the reveal is common knowledge before the second intake.
DEFAULT_COHORT_SEED=20260729
