# On Render these are all set by render.yaml -- this file is for local runs and
# for deployments configured by hand. Leave DATABASE_URL unset to use SQLite.

# ---------------------------------------------------------------------------
# Database -- PostgreSQL
# ---------------------------------------------------------------------------
# Paste the provider's connection string as given: the postgresql:// scheme is
# rewritten to postgresql+asyncpg:// and libpq-only parameters (sslmode, ...)
# are moved into the driver's connect args.
#
# On Render the blueprint injects the internal connection string. If a pooler
# sits in front of Postgres, point at the SESSION pooler, not the transaction
# pooler -- asyncpg's prepared statements need the former.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ---------------------------------------------------------------------------
# Cache -- Render Key Value / Redis
# ---------------------------------------------------------------------------
# Optional. Without it the API falls back to a per-process cache, which is
# correct for a single worker and wrong for multiple replicas.
REDIS_URL=rediss://default:PASSWORD@HOST:6379
CACHE_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=production

# Comma-separated. A bare hostname is assumed https://. localhost:3000 is
# allowed automatically whenever ENVIRONMENT is not production.
CORS_ORIGINS=https://survivors-web.onrender.com
INR_RATE=83
DELIBERATION_SECONDS=15

# The dataset seed for students with no cohort assigned. Give each teaching
# cohort its own seed via POST /api/v1/admin/cohorts -- reusing one across
# semesters means the reveal is common knowledge before the second intake.
DEFAULT_COHORT_SEED=20260729
