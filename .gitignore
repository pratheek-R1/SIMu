# ── Python / Backend ─────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# Virtual environments
.venv/
venv/
backend/.venv/

# ── Environment variables ────────────────────────────────────
.env
*.env
.env.local
.env.*.local
backend/.env.railway
!.env.example
!.env.local.example

# ── Databases ────────────────────────────────────────────────
# Covers survivors.db, dev.db and test_playthrough.db along with the
# SQLite sidecar files a WAL-mode connection leaves behind.
*.db
*.db-shm
*.db-wal
*.sqlite3

# ── Node / Frontend ──────────────────────────────────────────
node_modules/

# Next.js build output -- Render rebuilds this on every deploy; committing it
# bloats the repo and lets a stale bundle win over a fresh build.
.next/
out/
next-env.d.ts
*.tsbuildinfo

# ── OS / Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# ── Generated artefacts ──────────────────────────────────────
# A downloaded investment report carries the analyst's name and email address.
# It is output, not source, and does not belong in the repository.
meridian-investment-report*.html

# ── Misc ─────────────────────────────────────────────────────
*.log
*.pem
